<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CXAudioOutput.ViewModels" x:Class="CXAudioOutput.Views.ConnectionsView">
    <Grid x:Name="WirelessLayout" ColumnSpacing="16" RowSpacing="16" SizeChanged="WirelessLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="SharePanel" Grid.Row="0" Grid.Column="0" Style="{StaticResource AppCardStyle}" x:FieldModifier="internal">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="扫码收听" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="手机、平板或另一台电脑" Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource AcidSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="LIVE" FontFamily="{StaticResource DisplayFont}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AcidBrush}" CharacterSpacing="100"/>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Width="198" Height="198" Background="White" CornerRadius="17" Padding="10" HorizontalAlignment="Center" Margin="0,3,0,0">
                    <Grid>
                        <Image x:Name="QrImage" Stretch="Uniform" x:FieldModifier="internal"/>
                        <StackPanel x:Name="QrPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" x:FieldModifier="internal">
                            <FontIcon Glyph="" FontSize="24" Foreground="#1A1E18"/>
                            <TextBlock Text="选择可用网卡后显示二维码" FontSize="10" Foreground="#5D665A" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="145"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="打开链接，把浏览器变成扬声器。" Style="{StaticResource CaptionStyle}" TextAlignment="Center"/>
                <Grid Grid.Row="3" Padding="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="访问码" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AccessCodeText" Grid.Column="1" Text="······" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource AcidBrush}" CharacterSpacing="100" VerticalAlignment="Center" x:FieldModifier="internal"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Click="CopyCode_Click" AutomationProperties.Name="复制访问码" ToolTipService.ToolTip="复制访问码">
                            <FontIcon Glyph="" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Click="RotateCode_Click" AutomationProperties.Name="更换访问码" ToolTipService.ToolTip="更换访问码">
                            <FontIcon Glyph="" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <ComboBox x:Name="AddressComboBox" Grid.Row="4" HorizontalAlignment="Stretch" AutomationProperties.Name="收听链接网卡地址" PlaceholderText="选择网卡地址" SelectionChanged="Address_SelectionChanged" DisplayMemberPath="Display" x:FieldModifier="internal"/>
                <Grid Grid.Row="5" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ShareUrlText" Text="正在准备链接…" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:FieldModifier="internal"/>
                    <Button x:Name="CopyLinkButton" Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="10,5" MinHeight="30" Click="CopyLink_Click" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="" FontSize="12"/>
                            <TextBlock Text="复制" FontSize="10"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="6" Text="仅限本地网络 · 音频不会上传云端" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"/>
            </Grid>
        </Border>
        <Border x:Name="NetworkPanel" Grid.Row="0" Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="24,22,24,20" x:FieldModifier="internal">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="网络接口" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="只有勾选的网卡会接受其他设备连接；本机控制台始终可访问。" Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="允许多选" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch OnContent="开" OffContent="关" x:Name="MultiSelectSwitch" IsOn="True" MinWidth="0" AutomationProperties.Name="允许多选网卡" Toggled="MultiSelect_Toggled" x:FieldModifier="internal"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="NetworkSummaryText" Text="正在扫描网卡…" FontSize="12" FontWeight="SemiBold" x:FieldModifier="internal"/>
                        <TextBlock x:Name="UpdateStampText" Text="硬件状态 · 等待更新" Style="{StaticResource CaptionStyle}" FontSize="10" x:FieldModifier="internal"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SelectAllButton" Style="{StaticResource GhostButtonStyle}" Padding="10,5" MinHeight="30" Click="SelectAll_Click" x:FieldModifier="internal">
                            <TextBlock Text="全选物理" FontSize="10"/>
                        </Button>
                        <Button x:Name="ClearNetworkButton" Style="{StaticResource GhostButtonStyle}" Padding="10,5" MinHeight="30" Click="ClearNetwork_Click" x:FieldModifier="internal">
                            <TextBlock Text="仅本机" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Click="RefreshNetwork_Click" ToolTipService.ToolTip="刷新硬件状态">
                            <FontIcon Glyph="" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="NetworkWarningBar" Grid.Row="2" Severity="Warning" IsOpen="False" IsClosable="False" x:FieldModifier="internal"/>
                <Grid Grid.Row="3">
                    <ListView x:Name="AdapterList" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource PlainListViewItemStyle}" MaxHeight="330" Padding="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NetworkAdapterViewModel">
                                <Grid Background="#08FFFFFF" BorderBrush="#16F0F5E9" BorderThickness="1" CornerRadius="14" Padding="12,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" Tag="{x:Bind Id}" Click="AdapterCheckBox_Click" VerticalAlignment="Center" MinWidth="0"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Background="{x:Bind StatusPillBrush, Mode=OneWay}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse Width="5" Height="5" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="9"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="5,2" Visibility="{x:Bind VirtualVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock Text="虚拟" FontSize="8" Foreground="{ThemeResource TextMutedBrush}"/>
                                            </Border>
                                            <Border Background="{ThemeResource AcidSoftBrush}" CornerRadius="8" Padding="5,2" Visibility="{x:Bind UsbTetherVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                <TextBlock Text="USB" FontSize="8" Foreground="{ThemeResource AcidBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DescriptionLine, Mode=OneWay}" Style="{StaticResource CaptionStyle}" FontSize="10" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind IpText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind MacText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ReceiversPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource AppCardStyle}" x:FieldModifier="internal">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="接收设备" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="已连接的浏览器扬声器" Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource AcidSoftBrush}">
                        <TextBlock x:Name="ReceiverCountText" Text="0 台" FontFamily="{StaticResource DisplayFont}" FontSize="10" Foreground="{ThemeResource AcidBrush}" x:FieldModifier="internal"/>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="ReceiverList" SelectionMode="None" ItemContainerStyle="{StaticResource PlainListViewItemStyle}" MaxHeight="250" Background="Transparent" Padding="0" x:FieldModifier="internal">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReceiverViewModel">
                                <Grid Background="#08FFFFFF" BorderBrush="#16F0F5E9" BorderThickness="1" CornerRadius="14" Padding="12" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource AcidSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AcidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                            <Ellipse Width="5" Height="5" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind PlaybackText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource CaptionStyle}" FontSize="9"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind BufferText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind RttText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                            <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                            <TextBlock Text="{x:Bind HealthText, Mode=OneWay}" FontSize="10" Foreground="{x:Bind HealthBrush, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Tag="{x:Bind Id, Mode=OneWay}" Click="IdentifyReceiver_Click" ToolTipService.ToolTip="播放提示音">
                                            <FontIcon Glyph="" FontSize="12"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Tag="{x:Bind Id, Mode=OneWay}" Click="KickReceiver_Click" ToolTipService.ToolTip="断开设备">
                                            <FontIcon Glyph="" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ReceiverEmptyText" Text="还没有扬声器加入。扫描右侧二维码开始连接。" Style="{StaticResource BodyMutedStyle}" TextAlignment="Center" Margin="12,24" x:FieldModifier="internal"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
