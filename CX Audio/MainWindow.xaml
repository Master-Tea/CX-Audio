<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CXAudioOutput.ViewModels" x:Class="CXAudioOutput.MainWindow" Title="CX Audio">
    <Grid x:Name="RootGrid" Background="{ThemeResource PageGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="36" Height="36" Source="ms-appx:///Assets/logo.png" Stretch="Uniform" AutomationProperties.Name="CX Audio"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CX Audio" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="音量" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                    <Slider x:Name="QuickVolumeSlider" Width="105" Minimum="0" Maximum="100" StepFrequency="1" Value="100" AutomationProperties.Name="快速调节音量" ValueChanged="QuickVolume_ValueChanged"/>
                </StackPanel>
                <Border x:Name="ServicePill" Style="{StaticResource StatusPillStyle}" Background="{ThemeResource AcidSoftBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ServiceDot" Width="6" Height="6" Fill="{ThemeResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServicePillText" Text="正在启动" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220" CompactPaneLength="44" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" Background="Transparent" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavigationItem" Content="概览" Tag="overview" Icon="Home"/>
                <NavigationViewItem Content="无线连接" Tag="connections" Icon="Globe"/>
                <NavigationViewItem Content="Android 有线" Tag="android" Icon="Phone"/>
            </NavigationView.MenuItems>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Margin="16,4,16,0"/>
                <Frame x:Name="ContentFrame" Grid.Row="1"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
