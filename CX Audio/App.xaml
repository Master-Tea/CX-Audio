<Application
    x:Class="CXAudioOutput.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageGradientBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="PanelGradientBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroGradientBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="PanelStrokeStrongBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#606060" />
                    <SolidColorBrush x:Key="AcidBrush" Color="#006C67" />
                    <SolidColorBrush x:Key="AcidSoftBrush" Color="#1A006C67" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageGradientBrush" Color="#202020" />
                    <SolidColorBrush x:Key="PanelGradientBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="HeroGradientBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="PanelStrokeStrongBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CECECE" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#B1B1B1" />
                    <SolidColorBrush x:Key="AcidBrush" Color="#62D2C4" />
                    <SolidColorBrush x:Key="AcidSoftBrush" Color="#2662D2C4" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFC166" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF9990" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="SystemAccentColor">#00857A</Color>
            <Color x:Key="SystemAccentColorLight1">#E3FF93</Color>
            <Color x:Key="SystemAccentColorLight2">#ECFFB8</Color>
            <Color x:Key="SystemAccentColorLight3">#F4FFD9</Color>
            <Color x:Key="SystemAccentColorDark1">#C4F24A</Color>
            <Color x:Key="SystemAccentColorDark2">#A8D52E</Color>
            <Color x:Key="SystemAccentColorDark3">#82A91E</Color>



            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI Variable Text</FontFamily>

            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelGradientBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
                <Setter Property="Background" Value="{ThemeResource HeroGradientBrush}" />
                <Setter Property="Padding" Value="28" />
            </Style>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="150" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="BodyMutedStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LimeButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0CFFFFFF" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>

            <Style x:Key="StatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="Background" Value="{ThemeResource AcidSoftBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            </Style>

            <Style TargetType="Slider">
                <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
